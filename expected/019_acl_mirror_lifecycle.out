(9 rows)

GRANT SELECT ON unrel TO acl_life_s;
REVOKE SELECT ON unrel FROM acl_life_s;
\echo '--- Ownership moves to a role that was a grantee: its old grant entries disappear everywhere'
--- Ownership moves to a role that was a grantee: its old grant entries disappear everywhere
GRANT SELECT ON t TO acl_life_o2;
ALTER TABLE t OWNER TO acl_life_o2;
SELECT * FROM pg_temp.acl_entries('t');
       object_name       |  grantee   | privilege_type 
-------------------------+------------+----------------
 t                       | acl_life_r | SELECT
 t                       | acl_life_r | UPDATE
 t__current_valid        | PUBLIC     | DELETE
 t__current_valid        | PUBLIC     | INSERT
 t__current_valid        | PUBLIC     | SELECT
 t__current_valid        | PUBLIC     | UPDATE
 t__for_portion_of_valid | PUBLIC     | DELETE
 t__for_portion_of_valid | PUBLIC     | INSERT
 t__for_portion_of_valid | PUBLIC     | SELECT
 t__for_portion_of_valid | PUBLIC     | UPDATE
(10 rows)

GRANT SELECT ON unrel TO acl_life_s;
REVOKE SELECT ON unrel FROM acl_life_s;
\echo '--- REASSIGN OWNED'
--- REASSIGN OWNED
REASSIGN OWNED BY acl_life_o2 TO acl_life_o1;
SELECT c.relname, c.relowner::regrole AS owner
FROM pg_class AS c
WHERE c.relname IN ('t', 't__for_portion_of_valid', 't__current_valid')
ORDER BY 1;
         relname         |    owner    
-------------------------+-------------
 t                       | acl_life_o1
 t__current_valid        | acl_life_o1
 t__for_portion_of_valid | acl_life_o1
(3 rows)

SELECT * FROM pg_temp.acl_entries('t');
       object_name       |  grantee   | privilege_type 
-------------------------+------------+----------------
 t                       | acl_life_r | SELECT
 t                       | acl_life_r | UPDATE
 t__current_valid        | PUBLIC     | DELETE
 t__current_valid        | PUBLIC     | INSERT
 t__current_valid        | PUBLIC     | SELECT
 t__current_valid        | PUBLIC     | UPDATE
 t__for_portion_of_valid | PUBLIC     | DELETE
 t__for_portion_of_valid | PUBLIC     | INSERT
 t__for_portion_of_valid | PUBLIC     | SELECT
