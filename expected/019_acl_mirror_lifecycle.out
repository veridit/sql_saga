(10 rows)

GRANT SELECT ON unrel TO acl_life_s;
REVOKE SELECT ON unrel FROM acl_life_s;
/* Clean up */
SET client_min_messages = warning;
SELECT sql_saga.drop_system_versioning('s');
 drop_system_versioning 
------------------------
