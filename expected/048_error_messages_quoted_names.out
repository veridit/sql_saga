\i sql/include/test_setup.sql
--
-- test_setup.sql
--
-- Common setup for regression tests that need to be self-contained.
-- This script creates the extension, a user role, and grants permissions.
--
SET datestyle = 'ISO, YMD';
CREATE EXTENSION IF NOT EXISTS btree_gist;
CREATE EXTENSION IF NOT EXISTS sql_saga CASCADE;
DO $$
BEGIN
    CREATE ROLE sql_saga_unprivileged_user;
EXCEPTION WHEN duplicate_object THEN
END
$$;
GRANT USAGE ON SCHEMA sql_saga TO sql_saga_unprivileged_user;
GRANT SELECT ON ALL TABLES IN SCHEMA sql_saga TO sql_saga_unprivileged_user;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA sql_saga TO sql_saga_unprivileged_user;
/*
 * Allow the unprivileged user to create tables in the public schema.
 * This is required for tests that create their own tables.
 * PG 15+ restricts this by default.
 */
GRANT CREATE ON SCHEMA public TO PUBLIC;
-- Error messages name relations as PostgreSQL's own messages do: the plain name in double quotes,
-- schema-qualified when the relation is not on the search_path, never with identifier quoting inside.
SET client_min_messages = warning;
\set SHOW_CONTEXT never
BEGIN;
CREATE SCHEMA "my schema";
CREATE TABLE "my schema"."My Table" (id int, valid_range daterange NOT NULL, x text);
SELECT sql_saga.add_era('"my schema"."My Table"', 'valid_range', 'valid');
 add_era 
---------
 t
(1 row)

SELECT sql_saga.add_unique_key('"my schema"."My Table"', ARRAY['id'], key_type => 'primary', unique_key_name => 'my_table_id_valid');
  add_unique_key   
-------------------
 my_table_id_valid
(1 row)

SELECT sql_saga.add_for_portion_of_view('"my schema"."My Table"', 'valid');
 add_for_portion_of_view 
-------------------------
 t
(1 row)

CREATE TABLE "my schema"."Ref Table" (id int PRIMARY KEY, p_id int, note text);
SELECT sql_saga.add_regular_foreign_key('"my schema"."Ref Table"', ARRAY['p_id'], 'my_table_id_valid', foreign_key_name => 'ref_table_p_id_fkey');
 add_regular_foreign_key 
-------------------------
 ref_table_p_id_fkey
(1 row)

SELECT sql_saga.add_system_versioning('"my schema"."Ref Table"');
 add_system_versioning 
-----------------------
 
(1 row)

-- drop_protection
SAVEPOINT s;
DROP TRIGGER "Ref Table_truncate" ON "my schema"."Ref Table";
ERROR:  cannot drop trigger "Ref Table_truncate" on table "my schema.Ref Table" because it is used in SYSTEM_TIME period
ROLLBACK TO SAVEPOINT s;
SAVEPOINT s;
DROP TRIGGER for_portion_of_valid ON "my schema"."My Table__for_portion_of_valid";
ERROR:  cannot drop trigger "for_portion_of_valid" on view "my schema.My Table__for_portion_of_valid" because it is part of an updatable view for era "valid" on table "my schema.My Table"
ROLLBACK TO SAVEPOINT s;
SAVEPOINT s;
DROP TRIGGER ref_table_p_id_fkey_uk_update ON "my schema"."My Table";
ERROR:  cannot drop trigger "ref_table_p_id_fkey_uk_update" on table "my schema.My Table" because it is used in era foreign key "ref_table_p_id_fkey"
ROLLBACK TO SAVEPOINT s;
SAVEPOINT s;
DROP VIEW "my schema"."Ref Table_with_history" CASCADE;
ERROR:  cannot drop view "my schema.Ref Table_with_history" because it is used in SYSTEM VERSIONING for table "my schema.Ref Table"
ROLLBACK TO SAVEPOINT s;
-- health_checks
SAVEPOINT s;
ALTER TABLE "my schema"."Ref Table_history" DISABLE ROW LEVEL SECURITY;
ERROR:  history table "my schema.Ref Table_history" must keep row level security enabled, and forced exactly when its base table is, because it is used in SYSTEM VERSIONING for table "my schema.Ref Table"
ROLLBACK TO SAVEPOINT s;
SAVEPOINT s;
CREATE POLICY mine ON "my schema"."Ref Table_history" FOR SELECT USING (true);
ERROR:  sql_saga: policies on history table "my schema.Ref Table_history" are managed by sql_saga
HINT:  Create the policy on "my schema.Ref Table"; sql_saga copies its SELECT and ALL policies to the history.
ROLLBACK TO SAVEPOINT s;
SAVEPOINT s;
ALTER VIEW "my schema"."Ref Table_with_history" SET (security_invoker = off);
ERROR:  view "my schema.Ref Table_with_history" must keep security_invoker because it is used in SYSTEM VERSIONING for table "my schema.Ref Table"
ROLLBACK TO SAVEPOINT s;
-- rename_following
SAVEPOINT s;
ALTER TRIGGER ref_table_p_id_fkey_uk_update ON "my schema"."My Table" RENAME TO renamed;
ERROR:  cannot drop or rename trigger "ref_table_p_id_fkey_uk_update" on table "my schema.My Table" because it is used in an era foreign key "ref_table_p_id_fkey"
ROLLBACK TO SAVEPOINT s;
ROLLBACK;
RESET client_min_messages;
\i sql/include/test_teardown.sql
--
-- test_teardown.sql
--
-- Common teardown for regression tests. This script drops the unprivileged
-- user role created by test_setup.sql.
--
-- It is important to reset the role first, in case a test fails and
-- leaves the session role set to the user that is about to be dropped.
RESET ROLE;
-- Drop the extensions to ensure a clean state for the next test.
-- Use CASCADE to remove any dependent objects created by sql_saga.
DROP EXTENSION IF EXISTS sql_saga CASCADE;
DROP EXTENSION IF EXISTS btree_gist CASCADE;
-- Revoke any privileges held by the test user and drop any objects they own.
-- This is necessary before the role can be dropped.
DROP OWNED BY sql_saga_unprivileged_user;
DROP ROLE IF EXISTS sql_saga_unprivileged_user;
