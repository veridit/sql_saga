-- Referenced-side enforcement before the rename (reference error texts for after the rename).
BEGIN;
DELETE FROM fkr.par WHERE id = 1;
ERROR:  update or delete on table "fkr.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkr.rchild"
DETAIL:  The key is still referenced from table "fkr.rchild" and no other row of "fkr.par" has it.
ROLLBACK;
\echo '--- Rename the referencing column of both foreign keys'
--- Rename the referencing column of both foreign keys
ALTER TABLE fkr.rchild RENAME COLUMN par_id TO parent_id;
ALTER TABLE fkr.tchild RENAME COLUMN par_id TO parent_id;
\echo '--- After the rename: names unchanged, columns followed, no drift'
--- After the rename: names unchanged, columns followed, no drift
TABLE fkr.fk_state;
  foreign_key_name   |         type         | column_names | fk_table_columns_snapshot  | fk_check_constraint |        fk_index_name         |      uk_update_trigger       |      uk_delete_trigger       
---------------------+----------------------+--------------+----------------------------+---------------------+------------------------------+------------------------------+------------------------------
 rchild_par_id_fkey  | regular_to_temporal  | {parent_id}  | {id,parent_id}             | rchild_par_id_check | rchild_par_id_idx            | rchild_par_id_fkey_uk_update | rchild_par_id_fkey_uk_delete
 tchild_par_id_valid | temporal_to_temporal | {parent_id}  | {id,parent_id,valid_range} |                     | tchild_par_id_valid_gist_idx |                              | 
(2 rows)

TABLE fkr.par_triggers;
             tgname             |            function            | arg_foreign_key_name 
--------------------------------+--------------------------------+----------------------
 rchild_par_id_fkey_uk_delete   | sql_saga.uk_delete_check_c()   | rchild_par_id_fkey
 rchild_par_id_fkey_uk_truncate | sql_saga.uk_truncate_check_c() | rchild_par_id_fkey
 rchild_par_id_fkey_uk_update   | sql_saga.uk_update_check_c()   | rchild_par_id_fkey
(3 rows)

