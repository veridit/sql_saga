DETAIL:  The referenced key is not present in table "fkr.par".
ROLLBACK;
INSERT INTO fkr.rchild VALUES (2, 3);
\echo '--- Regular FK: referenced side still enforced (helper triggers use the new column)'
--- Regular FK: referenced side still enforced (helper triggers use the new column)
BEGIN;
DELETE FROM fkr.par WHERE id = 1;
ERROR:  update or delete on table "fkr.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkr.rchild"
DETAIL:  The key is still referenced from table "fkr.rchild" and no other row of "fkr.par" has it.
ROLLBACK;
BEGIN;
UPDATE fkr.par SET id = 4 WHERE id = 3;
ERROR:  update or delete on table "fkr.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkr.rchild"
DETAIL:  The key is still referenced from table "fkr.rchild" and no other row of "fkr.par" has it.
ROLLBACK;
\echo '--- Temporal FK: both sides still enforced'
--- Temporal FK: both sides still enforced
BEGIN;
INSERT INTO fkr.tchild VALUES (2, 99, '[2021-01-01,2022-01-01)');
ERROR:  insert or update on table "tchild" violates foreign key constraint "tchild_par_id_valid"
DETAIL:  Key (parent_id, valid_range)=(99, [2021-01-01,2022-01-01)) is not present in table "par".
ROLLBACK;
BEGIN;
DELETE FROM fkr.par WHERE id = 2;
ERROR:  update or delete on table "par" violates foreign key constraint "tchild_par_id_valid" on table "tchild"
DETAIL:  Key (id, valid_range)=(2, [2020-01-01,2030-01-01)) is still referenced from table "tchild".
ROLLBACK;
