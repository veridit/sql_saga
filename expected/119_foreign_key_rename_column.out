 tchild     | tchild_valid_check  | c       | CHECK ((NOT isempty(valid_range)))
(2 rows)

TABLE fkr.child_triggers;
 table_name |       tgname        |           function            |                                                                                                                                                                               def                                                                                                                                                                                
------------+---------------------+-------------------------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 rchild     | rchild_par_id_check | sql_saga.regular_fk_check_c() | CREATE CONSTRAINT TRIGGER rchild_par_id_check AFTER INSERT OR UPDATE ON fkr.rchild FROM par DEFERRABLE INITIALLY IMMEDIATE FOR EACH ROW EXECUTE FUNCTION sql_saga.regular_fk_check_c('rchild_par_id_fkey', 'fkr', 'rchild', '{parent_id}', '', '', '', 'fkr', 'par', '{id}', 'valid', 'null', 'null', 'SIMPLE', 'NO ACTION', 'NO ACTION', 'regular_to_temporal')
(1 row)

