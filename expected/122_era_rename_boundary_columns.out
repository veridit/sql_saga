--------------------+-------------------------------------
 other_user_trigger | sql_saga.e5_par_valid_template_sync
(1 row)

ROLLBACK;
-- (2) The synchronization function body was replaced by the user: refused, the body is untouched.
BEGIN;
CREATE OR REPLACE FUNCTION sql_saga.e5_par_valid_template_sync() RETURNS trigger LANGUAGE plpgsql
AS $user_body$BEGIN RAISE EXCEPTION 'user body'; END$user_body$;
ALTER TABLE e5.par RENAME COLUMN "Ends Before" TO ends;
ERROR:  sql_saga: cannot rename a column of era "valid" on table "e5.par": synchronization function sql_saga.e5_par_valid_template_sync() is not the canonical sql_saga function; restore it with sql_saga.add_synchronize_temporal_columns_trigger(table_oid regclass, era_name name) first
