BEGIN;
INSERT INTO fkk.rchild VALUES (3, 99);
ERROR:  new row for relation "rchild" violates check constraint "rchild_par_id_check"
DETAIL:  Failing row contains (3, 99).
ROLLBACK;
BEGIN;
INSERT INTO fkk.rchild2 VALUES (3, 99);
ERROR:  new row for relation "rchild2" violates check constraint "rchild2_owner_id_check"
DETAIL:  Failing row contains (3, 99).
ROLLBACK;
\echo '--- Regular FKs: referenced side'
--- Regular FKs: referenced side
BEGIN;
DELETE FROM fkk.par WHERE pid = 1;
ERROR:  update or delete on table "fkk.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkk.rchild"
ROLLBACK;
BEGIN;
DELETE FROM fkk.par WHERE pid = 4;
ERROR:  update or delete on table "fkk.par" violates foreign key constraint "rchild2_owner_id_fkey" on table "fkk.rchild2"
ROLLBACK;
BEGIN;
UPDATE fkk.par SET pid = 5 WHERE pid = 4;
ERROR:  update or delete on table "fkk.par" violates foreign key constraint "rchild2_owner_id_fkey" on table "fkk.rchild2"
ROLLBACK;
