UPDATE fkk.par SET valid_range = '[2020-01-01,2020-06-01)' WHERE pid = 1;
UPDATE fkk.par SET label = 'changed' WHERE pid = 1;
ROLLBACK;
BEGIN;
DELETE FROM fkk.par WHERE pid = 3;
