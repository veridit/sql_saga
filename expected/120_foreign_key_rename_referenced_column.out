ROLLBACK;
\echo '--- Firing modes still effective under replica role'
--- Firing modes still effective under replica role
BEGIN;
SET LOCAL session_replication_role = replica;
SAVEPOINT replica_delete;
DELETE FROM fkk.par WHERE pid = 1;
ERROR:  update or delete on table "fkk.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkk.rchild"
ROLLBACK TO SAVEPOINT replica_delete;
SAVEPOINT replica_update;
UPDATE fkk.par SET pid = 6 WHERE pid = 1;
ERROR:  update or delete on table "fkk.par" violates foreign key constraint "rchild_par_id_fkey" on table "fkk.rchild"
ROLLBACK TO SAVEPOINT replica_update;
ROLLBACK;
\echo '--- Temporal FK: both sides'
--- Temporal FK: both sides
BEGIN;
INSERT INTO fkk.tchild VALUES (2, 99, '[2021-01-01,2022-01-01)');
ERROR:  insert or update on table "tchild" violates foreign key constraint "tchild_par_id_valid"
DETAIL:  Key (par_id, valid_range)=(99, [2021-01-01,2022-01-01)) is not present in table "par".
ROLLBACK;
BEGIN;
DELETE FROM fkk.par WHERE pid = 2;
ERROR:  update or delete on table "par" violates foreign key constraint "tchild_par_id_valid" on table "tchild"
DETAIL:  Key (pid, valid_range)=(2, [2020-01-01,2030-01-01)) is still referenced from table "tchild".
ROLLBACK;
