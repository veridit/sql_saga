SELECT sql_saga.add_unique_key('xc', ARRAY['lu', 'es'], key_type => 'natural', mutually_exclusive_columns => ARRAY['lu', 'es']);
NOTICE:  sql_saga: Added constraints to table xc_167.xc: ADD CONSTRAINT xc_lu_es_valid UNIQUE NULLS NOT DISTINCT (lu, es, valid_range WITHOUT OVERLAPS); ADD CONSTRAINT xc_lu_es_valid_xor_check CHECK ((num_nonnulls(lu, es) <= 1)); ADD CONSTRAINT xc_lu_es_valid_lu_pk_consistency_excl EXCLUDE USING gist (lu WITH =, id WITH <>) WHERE (((lu IS NOT NULL) AND (es IS NULL))); ADD CONSTRAINT xc_lu_es_valid_es_pk_consistency_excl EXCLUDE USING gist (es WITH =, id WITH <>) WHERE (((es IS NOT NULL) AND (lu IS NULL))); ADD CONSTRAINT xc_lu_es_valid_lu_nk_consistency_excl EXCLUDE USING gist (id WITH =, lu WITH <>); ADD CONSTRAINT xc_lu_es_valid_es_nk_consistency_excl EXCLUDE USING gist (id WITH =, es WITH <>)
 add_unique_key 
