\i sql/include/test_setup.sql
--
-- test_setup.sql
--
-- Common setup for regression tests that need to be self-contained.
-- This script creates the extension, a user role, and grants permissions.
--
SET datestyle = 'ISO, YMD';
CREATE EXTENSION IF NOT EXISTS btree_gist;
CREATE EXTENSION IF NOT EXISTS sql_saga CASCADE;
DO $$
BEGIN
    CREATE ROLE sql_saga_unprivileged_user;
EXCEPTION WHEN duplicate_object THEN
END
$$;
GRANT USAGE ON SCHEMA sql_saga TO sql_saga_unprivileged_user;
GRANT SELECT ON ALL TABLES IN SCHEMA sql_saga TO sql_saga_unprivileged_user;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA sql_saga TO sql_saga_unprivileged_user;
/*
 * Allow the unprivileged user to create tables in the public schema.
 * This is required for tests that create their own tables.
 * PG 15+ restricts this by default.
 */
GRANT CREATE ON SCHEMA public TO PUBLIC;
/*
 * P1: sql_saga.temporal_merge_cache must not let one role make another role run its SQL.
 *
 * The PL/pgSQL planner keeps generated plans in sql_saga.temporal_merge_cache (shared by all
 * sessions) and EXECUTEs a cached plan's SQL in the session of whoever hits the cache next.
 * If an unprivileged role can write that table, it can plant SQL that the next caller, e.g. the
 * table owner, executes with the caller's privileges (a confused deputy).
 *
 * Correct behaviour (the security property, independent of how a fix achieves it): no SQL chosen
 * by another role is ever executed by a temporal_merge run. Whether the attacker's writes are
 * refused, ignored or rejected at use time is up to the fix; this test asserts only that nothing
 * is exfiltrated and that the owner's own update still produces the right timeline.
 */
\set SHOW_CONTEXT never
SET client_min_messages = warning;
CREATE ROLE tmc_attacker;
CREATE ROLE tmc_owner;
GRANT CREATE ON SCHEMA public TO tmc_owner;
SET ROLE tmc_owner;
CREATE TABLE tmc_secret (v text);
INSERT INTO tmc_secret VALUES ('top secret');
CREATE TABLE tmc_loot (v text);
GRANT SELECT, INSERT ON tmc_loot TO PUBLIC;
CREATE TABLE tmc_t (id int, valid_range daterange NOT NULL, x text, PRIMARY KEY (id, valid_range WITHOUT OVERLAPS));
SELECT sql_saga.add_era('tmc_t', 'valid_range', 'valid');
 add_era 
---------
 t
(1 row)

SELECT sql_saga.add_for_portion_of_view('tmc_t', 'valid');
 add_for_portion_of_view 
-------------------------
 t
(1 row)

INSERT INTO tmc_t VALUES (1, '[2020-01-01,infinity)', 'start');
RESET ROLE;
-- The attacker may legitimately use the table, but cannot read the secret.
GRANT SELECT, INSERT, UPDATE, DELETE ON tmc_t, tmc_t__for_portion_of_valid TO tmc_attacker;
-- Test helper (superuser): empty the shared plan cache if this version still has one.
CREATE PROCEDURE public.tmc_clear_shared_cache() LANGUAGE plpgsql AS $$
BEGIN
    IF to_regclass('sql_saga.temporal_merge_cache') IS NOT NULL THEN
        EXECUTE 'DELETE FROM sql_saga.temporal_merge_cache';
    END IF;
END $$;
REVOKE ALL ON PROCEDURE public.tmc_clear_shared_cache() FROM PUBLIC;
RESET client_min_messages;
\echo '--- The owner runs a FOR PORTION OF update with the PL/pgSQL planner'
--- The owner runs a FOR PORTION OF update with the PL/pgSQL planner
CALL public.tmc_clear_shared_cache();
SET ROLE tmc_owner;
SET sql_saga.temporal_merge.use_plpgsql_planner = true;
UPDATE tmc_t__for_portion_of_valid SET x = 'seed', valid_range = '[2020-03-01,2020-06-01)' WHERE id = 1;
RESET sql_saga.temporal_merge.use_plpgsql_planner;
RESET ROLE;
\echo '--- The attacker cannot read the secret directly'
--- The attacker cannot read the secret directly
SET ROLE tmc_attacker;
SELECT count(*) FROM tmc_secret; -- fail
ERROR:  permission denied for table tmc_secret
RESET ROLE;
\echo '--- Attack 1: the attacker rewrites the cached plan directly'
--- Attack 1: the attacker rewrites the cached plan directly
-- Whether the write is refused is not part of the specification; only the effect on later runs is.
SET ROLE tmc_attacker;
DO $$
BEGIN
    UPDATE sql_saga.temporal_merge_cache
    SET plan_sqls = jsonb_build_array(jsonb_build_object('type', 'setup', 'sql', 'INSERT INTO public.tmc_loot SELECT v FROM public.tmc_secret')) || plan_sqls;
EXCEPTION WHEN OTHERS THEN NULL;
END $$;
RESET ROLE;
\echo '--- In a new session (empty per-session cache) the owner runs the same kind of update again'
--- In a new session (empty per-session cache) the owner runs the same kind of update again
\c
\set SHOW_CONTEXT never
SET datestyle = 'ISO, YMD';
SET client_min_messages = warning;
SET ROLE tmc_owner;
SET sql_saga.temporal_merge.use_plpgsql_planner = true;
UPDATE tmc_t__for_portion_of_valid SET x = 'seed2', valid_range = '[2020-07-01,2020-09-01)' WHERE id = 1;
RESET sql_saga.temporal_merge.use_plpgsql_planner;
RESET ROLE;
RESET client_min_messages;
SELECT count(*) AS exfiltrated_rows_after_attack1 FROM tmc_loot;
 exfiltrated_rows_after_attack1 
--------------------------------
                              0
(1 row)

\echo '--- Attack 2: the attacker stores a poisoned plan through the cache API under the real key'
--- Attack 2: the attacker stores a poisoned plan through the cache API under the real key
-- Start from a clean slate so attack 2 is measured on its own: empty loot, and any shared cache
-- entry produced by sql_saga itself for the owner's update.
TRUNCATE tmc_loot;
CALL public.tmc_clear_shared_cache();
SET client_min_messages = warning;
SET ROLE tmc_owner;
SET sql_saga.temporal_merge.use_plpgsql_planner = true;
UPDATE tmc_t__for_portion_of_valid SET x = 'seed2', valid_range = '[2020-07-01,2020-09-01)' WHERE id = 1;
RESET sql_saga.temporal_merge.use_plpgsql_planner;
RESET ROLE;
RESET client_min_messages;
-- The attacker learns everything it needs WITHOUT reading the shared cache:
-- * the cache key and source hash are deterministic and computed by PUBLIC helper functions;
-- * a valid plan body comes from the attacker's own session-local plan cache, filled by running
--   the same kind of update itself (it may use the table) in a transaction it rolls back.
-- The attacker works in its own session (fresh session-local cache).
\c
\set SHOW_CONTEXT never
SET datestyle = 'ISO, YMD';
SET ROLE tmc_attacker;
SET client_min_messages = warning;
SET sql_saga.temporal_merge.use_plpgsql_planner = true;
CREATE TEMP TABLE tmc_attack (cache_key text, source_columns_hash text, plan_sqls jsonb);
CREATE TEMP TABLE tmc_src_shape (row_id bigint, id int, valid_range daterange, x text, merge_status jsonb);
BEGIN;
UPDATE tmc_t__for_portion_of_valid SET x = 'probe', valid_range = '[2021-01-01,2021-02-01)' WHERE id = 1;
SELECT sql_saga.temporal_merge_cache_key('tmc_t'::regclass, ARRAY['id'], ARRAY[]::text[], 'UPDATE_FOR_PORTION_OF',
                                         'valid', 'row_id', NULL, 'daterange'::regtype, 'NONE', NULL, false) AS att_key,
       sql_saga.temporal_merge_source_columns_hash('pg_temp.tmc_src_shape'::regclass, ARRAY['id'], ARRAY['valid_range'], 'row_id', NULL) AS att_hash,
       (SELECT l1.plan_sqls FROM pg_temp.temporal_merge_plan_cache AS l1 LIMIT 1)::text AS att_plan
\gset
-- Undo the probe entirely; only what the attacker learned (psql variables) remains.
ROLLBACK;
RESET sql_saga.temporal_merge.use_plpgsql_planner;
RESET client_min_messages;
INSERT INTO tmc_attack VALUES (:'att_key', :'att_hash', :'att_plan'::jsonb);
-- The attack is really attempted: key, hash and a plan body are known to the attacker.
SELECT cache_key IS NOT NULL AND source_columns_hash IS NOT NULL AND plan_sqls IS NOT NULL AS attack_material_known
FROM tmc_attack;
 attack_material_known 
-----------------------
 t
(1 row)

DO $$
DECLARE a record;
BEGIN
    SELECT * INTO a FROM tmc_attack;
    CALL sql_saga.temporal_merge_cache_store(
        a.cache_key, a.source_columns_hash,
        jsonb_build_array(jsonb_build_object('type', 'setup', 'sql', 'INSERT INTO public.tmc_loot SELECT v FROM public.tmc_secret')) || a.plan_sqls);
EXCEPTION WHEN OTHERS THEN NULL;  -- refusal is one valid outcome; the effect is what is asserted
END $$;
RESET ROLE;
\c
\set SHOW_CONTEXT never
SET datestyle = 'ISO, YMD';
SET client_min_messages = warning;
SET ROLE tmc_owner;
SET sql_saga.temporal_merge.use_plpgsql_planner = true;
UPDATE tmc_t__for_portion_of_valid SET x = 'seed3', valid_range = '[2020-10-01,2020-11-01)' WHERE id = 1;
RESET sql_saga.temporal_merge.use_plpgsql_planner;
RESET ROLE;
RESET client_min_messages;
SELECT count(*) AS exfiltrated_rows_after_attack2 FROM tmc_loot;
 exfiltrated_rows_after_attack2 
--------------------------------
                              0
(1 row)

-- The owner's updates did their job.
SELECT x, valid_range FROM tmc_t ORDER BY valid_range;
   x   |       valid_range       
-------+-------------------------
 start | [2020-01-01,2020-03-01)
 seed  | [2020-03-01,2020-06-01)
 start | [2020-06-01,2020-07-01)
 seed2 | [2020-07-01,2020-09-01)
 start | [2020-09-01,2020-10-01)
 seed3 | [2020-10-01,2020-11-01)
 start | [2020-11-01,infinity)
(7 rows)

/* Clean up */
SET client_min_messages = warning;
CALL public.tmc_clear_shared_cache();
SET ROLE tmc_owner;
SELECT sql_saga.drop_for_portion_of_view('tmc_t', 'valid');
 drop_for_portion_of_view 
--------------------------
 t
(1 row)

SELECT sql_saga.drop_era('tmc_t', 'valid');
 drop_era 
----------
 t
(1 row)

DROP TABLE tmc_t, tmc_secret, tmc_loot;
RESET ROLE;
DROP PROCEDURE public.tmc_clear_shared_cache();
DROP OWNED BY tmc_attacker, tmc_owner;
DROP ROLE tmc_attacker, tmc_owner;
RESET client_min_messages;
\i sql/include/test_teardown.sql
--
-- test_teardown.sql
--
-- Common teardown for regression tests. This script drops the unprivileged
-- user role created by test_setup.sql.
--
-- It is important to reset the role first, in case a test fails and
-- leaves the session role set to the user that is about to be dropped.
RESET ROLE;
-- Drop the extensions to ensure a clean state for the next test.
-- Use CASCADE to remove any dependent objects created by sql_saga.
DROP EXTENSION IF EXISTS sql_saga CASCADE;
DROP EXTENSION IF EXISTS btree_gist CASCADE;
-- Revoke any privileges held by the test user and drop any objects they own.
-- This is necessary before the role can be dropped.
DROP OWNED BY sql_saga_unprivileged_user;
DROP ROLE IF EXISTS sql_saga_unprivileged_user;
