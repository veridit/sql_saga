(1 row)

INSERT INTO tdoc VALUES (1, 'a', '[2020-01-01,infinity)', 'a'), (2, 'b', '[2020-01-01,infinity)', 'b');
GRANT SELECT ON tdoc TO rls_a;
ALTER TABLE tdoc ENABLE ROW LEVEL SECURITY;
