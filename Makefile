MODULE_big = sql_saga
EXTENSION = sql_saga
EXTVERSION = $(shell grep default_version $(EXTENSION).control | sed -e "s/default_version[[:space:]]*=[[:space:]]*'\([^']*\)'/\1/")

# The current install script and the update scripts to it are generated. Released install scripts and
# hand-written update scripts are immutable release artifacts kept in versions/. Never modify an artifact
# after release.
# Python 3 (standard library only) runs the update-script generator. PGXS's Makefile.global sets PYTHON to the
# interpreter PostgreSQL was configured with, which may not exist here, so this has its own name.
SQL_SAGA_PYTHON ?= python3
FROZEN_1_0_1_1_SHA256 = 37405fd81634b9cc7b088638334a9158c38252ce4d3ca69506d7fe1b2067c5f7
ifeq ($(EXTVERSION),1.2)
DIRECT_UPDATE = $(EXTENSION)--1.0--$(EXTVERSION).sql
DATA = versions/$(EXTENSION)--1.0.sql versions/$(EXTENSION)--1.0--1.1.sql \
	versions/$(EXTENSION)--1.1.sql versions/$(EXTENSION)--1.1--1.2.sql \
	$(DIRECT_UPDATE) $(EXTENSION)--$(EXTVERSION).sql sql_saga_upgrade_preflight.sql
else ifeq ($(EXTVERSION),1.3)
# Direct single-hop updates from every released version (see doc/upgrade.md), all
# generated by devops/generate_update_scripts.py (Python 3, standard library only) from SHA-256 authenticated
# frozen artifacts, the changed src routines and the devops/upgrade_1_3_*.sql fragments.
DIRECT_UPDATE = $(EXTENSION)--1.0--1.3.sql $(EXTENSION)--1.1--1.3.sql $(EXTENSION)--1.2--1.3.sql
UPDATE_GENERATOR_INPUTS = devops/generate_update_scripts.py \
	versions/$(EXTENSION)--1.0--1.2.sql versions/$(EXTENSION)--1.1--1.2.sql versions/$(EXTENSION)--1.2.sql \
	devops/upgrade_1_3_preamble.sql devops/upgrade_1_3_schema.sql devops/upgrade_1_3_repairs.sql \
	$(wildcard src/[0-9][a-z]_*.sql)
DATA = versions/$(EXTENSION)--1.0.sql versions/$(EXTENSION)--1.0--1.1.sql \
	versions/$(EXTENSION)--1.1.sql versions/$(EXTENSION)--1.1--1.2.sql \
	versions/$(EXTENSION)--1.2.sql versions/$(EXTENSION)--1.0--1.2.sql \
	$(DIRECT_UPDATE) $(EXTENSION)--$(EXTVERSION).sql sql_saga_upgrade_preflight.sql
else
$(error no update-script generation rule for EXTVERSION $(EXTVERSION))
endif

# Add generated scripts to EXTRA_CLEAN so they are removed by `make clean`. Frozen versions/ files never are.
EXTRA_CLEAN = $(EXTENSION)--$(EXTVERSION).sql $(DIRECT_UPDATE) .update_scripts_$(EXTVERSION).stamp

DOCS = README.md
#README.html: README.md
#	jq --slurp --raw-input '{"text": "\(.)", "mode": "markdown"}' < README.md | curl --data @- https://api.github.com/markdown > README.html

SQL_FILES = $(wildcard sql/[0-9][0-9][0-9]_*.sql)

REGRESS_ALL = $(patsubst sql/%.sql,%,$(SQL_FILES))
BENCHMARK_TESTS = $(foreach test,$(REGRESS_ALL),$(if $(findstring benchmark,$(test)),$(test)))
REGRESS_FAST_LIST = $(filter-out $(BENCHMARK_TESTS),$(REGRESS_ALL))

# By default, run all tests. If 'fast' or 'benchmark' are goals, run the respective subset.
REGRESS_TO_RUN = $(REGRESS_ALL)
ifeq (fast,$(filter fast,$(MAKECMDGOALS)))
	REGRESS_TO_RUN = $(REGRESS_FAST_LIST)
endif
ifeq (benchmark,$(filter benchmark,$(MAKECMDGOALS)))
	REGRESS_TO_RUN = $(BENCHMARK_TESTS)
endif

REGRESS = $(if $(TESTS),$(patsubst sql/%,%,$(TESTS)),$(REGRESS_TO_RUN))
override CONTRIB_TESTDB = sql_saga_regress
REGRESS_OPTS += --create-role=$(CONTRIB_TESTDB)

# Conditionally add pg_stat_monitor if it's available.
# We connect to template1 as it's guaranteed to exist.
# The `psql` command will return an empty string if the extension is not found or if psql fails,
# in which case the option will not be added.
PG_STAT_MONITOR_AVAILABLE = $(shell psql -d template1 --quiet -t -c "SELECT 1 FROM pg_available_extensions WHERE name = 'pg_stat_monitor'" 2>/dev/null | grep -q 1 && echo yes)
ifeq ($(PG_STAT_MONITOR_AVAILABLE),yes)
	REGRESS_OPTS += --load-extension=pg_stat_monitor
endif

OBJS = src/sql_saga.o src/covers_without_gaps.o $(WIN32RES)

PG_CONFIG = pg_config
PGXS := $(shell $(PG_CONFIG) --pgxs)
include $(PGXS)

# Redefine the `all` target to build both the C library (SHLIB) and our
# generated SQL script. PGXS provides the rule to build SHLIB.
all: $(SHLIB) $(EXTENSION)--$(EXTVERSION).sql $(DIRECT_UPDATE)

# Add the generated SQL file as a direct dependency of the `install` target.
# This ensures it is always rebuilt if its source files have changed before
# tests are run.
install: $(EXTENSION)--$(EXTVERSION).sql $(DIRECT_UPDATE)

# ---------------------------------------------------------------------------
# Native (Rust/pgrx) planner library: an INTERNAL part of sql_saga.
# Only the shared library is built and installed (as $libdir/sql_saga_native).
# There is no sql_saga_native.control, so it is never a separately installable
# extension. cargo-pgrx is not needed: plain `cargo build` + PGRX_PG_CONFIG_PATH.
# ---------------------------------------------------------------------------
CARGO ?= cargo
NATIVE_DIR = native
NATIVE_LIB_NAME = sql_saga_native
NATIVE_PG_CONFIG := $(shell command -v $(PG_CONFIG))
NATIVE_PG_MAJOR := $(shell $(PG_CONFIG) --version | sed -E 's/^PostgreSQL ([0-9]+).*/\1/')
NATIVE_BUILT = $(NATIVE_DIR)/target/release/lib$(NATIVE_LIB_NAME)$(DLSUFFIX)
NATIVE_SOURCES = $(wildcard $(NATIVE_DIR)/src/*.rs $(NATIVE_DIR)/src/*/*.rs) $(NATIVE_DIR)/build.rs \
                 $(NATIVE_DIR)/Cargo.toml $(NATIVE_DIR)/Cargo.lock $(EXTENSION).control

# macOS: bindgen must use Apple's libclang and SDK (Homebrew llvm fails on inttypes.h).
ifeq ($(PORTNAME),darwin)
export LIBCLANG_PATH ?= $(abspath $(dir $(shell xcrun --find clang))../lib)
export BINDGEN_EXTRA_CLANG_ARGS ?= -isysroot $(shell xcrun --show-sdk-path)
endif

$(NATIVE_BUILT): $(NATIVE_SOURCES)
	cd $(NATIVE_DIR) && PGRX_PG_CONFIG_PATH='$(NATIVE_PG_CONFIG)' $(CARGO) build --release --lib --locked --no-default-features --features pg$(NATIVE_PG_MAJOR)
	@test -f $@ || { echo "native build did not produce $@" >&2; exit 1; }

.PHONY: native install-native uninstall-native clean-native test-native
native: $(NATIVE_BUILT)
all: native

install: install-native
install-native: $(NATIVE_BUILT) installdirs
	$(INSTALL_SHLIB) $(NATIVE_BUILT) '$(DESTDIR)$(pkglibdir)/$(NATIVE_LIB_NAME)$(DLSUFFIX)'
	@# Remove artifacts left by the old `cargo pgrx install` (made it look like a separate extension).
	rm -f '$(DESTDIR)$(datadir)/extension/$(NATIVE_LIB_NAME).control' '$(DESTDIR)$(datadir)/extension/$(NATIVE_LIB_NAME)--'*.sql

uninstall: uninstall-native
uninstall-native:
	rm -f '$(DESTDIR)$(pkglibdir)/$(NATIVE_LIB_NAME)$(DLSUFFIX)'

# `cargo test --lib` links a standalone executable that references PostgreSQL server symbols through
# pgrx; only the server defines them. On Linux, link that executable (in its own target dir, so the
# installed library is never built with these flags) with unresolved symbols allowed and lazy binding;
# the pure-Rust unit tests never call into PostgreSQL. The test module defines the few data symbols.
ifeq ($(PORTNAME),linux)
NATIVE_TEST_ENV = RUSTFLAGS='-Crelro-level=off -Clink-arg=-Wl,--unresolved-symbols=ignore-all -Clink-arg=-Wl,-z,lazy' CARGO_TARGET_DIR=target/test-native
endif
test-native:
	cd $(NATIVE_DIR) && $(NATIVE_TEST_ENV) PGRX_PG_CONFIG_PATH='$(NATIVE_PG_CONFIG)' $(CARGO) test --lib --locked

clean-native:
	cd $(NATIVE_DIR) && $(CARGO) clean


# Build the main extension script from component files.
# The source files use Na_ pattern (e.g., 0a_, 1b_, 2c_) to ensure correct concatenation order.
# This provides 26 positions per digit group instead of 10 with pure numeric prefixes.
$(EXTENSION)--$(EXTVERSION).sql: $(wildcard src/[0-9][a-z]_*.sql)
	cat $^ > $@

# PostgreSQL selects the shortest update path. Build the direct 1.0-to-current script from the frozen
# 1.0--1.1 artifact, changing only its exact native-version guard, then append the headerless current
# update body. The checks intentionally fail if the frozen guard changes or the transformation touches
# any other line.
# The frozen $$validate_fk_helpers$$ aggregates the key columns once per foreign key, so a helper shared by
# several regular foreign keys on one key is refused. The direct script also replaces that one FROM line
# (identified by its unique preceding line) with one row per helper and key; the released standalone
# 1.0--1.1 file keeps the defect (see doc/upgrade.md).
ifeq ($(EXTVERSION),1.2)
$(DIRECT_UPDATE): versions/$(EXTENSION)--1.0--1.1.sql versions/$(EXTENSION)--1.1--$(EXTVERSION).sql
	@set -eu; \
	old="DO \$$native_guard\$$ BEGIN IF sql_saga.native_library_version() <> '1.1' THEN RAISE EXCEPTION 'sql_saga: native library version % does not match extension update version 1.1', sql_saga.native_library_version() USING ERRCODE = 'object_not_in_prerequisite_state', HINT = 'Install the sql_saga 1.1 native library and restart PostgreSQL before retrying ALTER EXTENSION.'; END IF; END; \$$native_guard\$$;"; \
	new="DO \$$native_guard\$$ BEGIN IF sql_saga.native_library_version() <> '$(EXTVERSION)' THEN RAISE EXCEPTION 'sql_saga: native library version % does not match extension update version $(EXTVERSION)', sql_saga.native_library_version() USING ERRCODE = 'object_not_in_prerequisite_state', HINT = 'Install the sql_saga $(EXTVERSION) native library and restart PostgreSQL before retrying ALTER EXTENSION.'; END IF; END; \$$native_guard\$$;"; \
	fk_anchor='               pg_catalog.array_agg(c.name ORDER BY c.ordinality) AS stable_columns'; \
	fk_old='        FROM sql_saga.foreign_keys AS fk'; \
	fk_new='        FROM (SELECT DISTINCT f.fk_helper_function, f.unique_key_name, f.type FROM sql_saga.foreign_keys AS f) AS fk'; \
	tmp='$@.tmp'; retargeted='$@.retargeted'; restored='$@.restored'; fkfixed='$@.fkfixed'; \
	trap 'rm -f "$$tmp" "$$retargeted" "$$restored" "$$fkfixed"' EXIT HUP INT TERM; \
	if command -v sha256sum >/dev/null 2>&1; then \
		actual_hash=$$(sha256sum '$<' | awk '{print $$1}'); \
	elif command -v shasum >/dev/null 2>&1; then \
		actual_hash=$$(shasum -a 256 '$<' | awk '{print $$1}'); \
	else \
		echo 'cannot authenticate $<: neither sha256sum nor shasum is available' >&2; exit 1; \
	fi; \
	[ "$$actual_hash" = '$(FROZEN_1_0_1_1_SHA256)' ] || { echo "frozen artifact $< failed SHA-256 authentication: expected $(FROZEN_1_0_1_1_SHA256), got $$actual_hash" >&2; exit 1; }; \
	expected_header='\echo Use "ALTER EXTENSION sql_saga UPDATE TO '\''$(EXTVERSION)'\''" to load this file. \quit'; \
	IFS= read -r actual_header <'versions/$(EXTENSION)--1.1--$(EXTVERSION).sql'; \
	[ "$$actual_header" = "$$expected_header" ] || { echo "unexpected header in versions/$(EXTENSION)--1.1--$(EXTVERSION).sql: expected $$expected_header" >&2; exit 1; }; \
	count=$$(grep -Fxc "$$old" '$<' || true); \
	[ "$$count" = 1 ] || { echo "expected exactly one released 1.1 native guard in $<, found $$count" >&2; exit 1; }; \
	awk -v old="$$old" -v new="$$new" '{ if ($$0 == old) print new; else print }' '$<' >"$$retargeted"; \
	new_count=$$(grep -Fxc "$$new" "$$retargeted" || true); \
	[ "$$new_count" = 1 ] || { echo "failed to generate exactly one $(EXTVERSION) native guard" >&2; exit 1; }; \
	awk -v old="$$old" -v new="$$new" '{ if ($$0 == new) print old; else print }' "$$retargeted" >"$$restored"; \
	cmp -s '$<' "$$restored" || { echo "native-guard transformation changed another line" >&2; exit 1; }; \
	anchor_count=$$(grep -Fxc "$$fk_anchor" '$<' || true); \
	[ "$$anchor_count" = 1 ] || { echo "expected exactly one frozen validate_fk_helpers stable_columns line in $<, found $$anchor_count" >&2; exit 1; }; \
	[ "$$(grep -Fxc "$$fk_new" '$<' || true)" = 0 ] || { echo "frozen $< already contains the shared-helper validator line" >&2; exit 1; }; \
	awk -v anchor="$$fk_anchor" -v old="$$fk_old" -v new="$$fk_new" '{ if (prev == anchor && $$0 == old) print new; else print; prev = $$0 }' "$$retargeted" >"$$fkfixed"; \
	[ "$$(grep -Fxc "$$fk_new" "$$fkfixed" || true)" = 1 ] || { echo "failed to generate exactly one shared-helper validator line" >&2; exit 1; }; \
	awk -v old="$$fk_old" -v new="$$fk_new" '{ if ($$0 == new) print old; else print }' "$$fkfixed" >"$$restored"; \
	cmp -s "$$retargeted" "$$restored" || { echo "shared-helper validator transformation changed another line" >&2; exit 1; }; \
	cat "$$fkfixed" >"$$tmp"; \
	sed '1d' 'versions/$(EXTENSION)--1.1--$(EXTVERSION).sql' >>"$$tmp"; \
	mv "$$tmp" '$@'
else
# One generator run validates and builds all three scripts before publishing any, then replaces each file
# atomically; the stamp is written only on success. The stamp makes that a single recipe
# under GNU make 3.81, which lacks grouped targets. If any generated script is missing when make starts, the
# stamp is forced out of date, so all three are regenerated together by that one recipe (parallel safe).
UPDATE_SCRIPTS_MISSING = $(filter-out $(wildcard $(DIRECT_UPDATE)),$(DIRECT_UPDATE))
$(DIRECT_UPDATE): .update_scripts_$(EXTVERSION).stamp
	@test -f '$@'
.update_scripts_$(EXTVERSION).stamp: $(UPDATE_GENERATOR_INPUTS) $(if $(UPDATE_SCRIPTS_MISSING),update_scripts_force)
	$(SQL_SAGA_PYTHON) devops/generate_update_scripts.py --src src --versions versions --devops devops --outdir . --extversion $(EXTVERSION)
	touch '$@'
.PHONY: update_scripts_force
update_scripts_force:
endif

# Unit tests of the update-script generator (no database needed).
.PHONY: test-generator
test-generator:
	$(SQL_SAGA_PYTHON) devops/test_generate_update_scripts.py

# test is a convenient alias for installcheck.
# To run all tests: `make test`
# To run fast tests (excluding benchmarks): `make test fast`
# To run benchmark tests: `make test benchmark`
# To run a single test: `make test TESTS=001_install`
# To run a subset of tests: `make test TESTS="001_install 002_era"`
.PHONY: test setup_test_files
test: setup_test_files installcheck



# expected updates the .out files for the last run test suite.
# It parses regression.out to find which tests were run, or uses TESTS if provided.
# Usage: `make test [fast|benchmark|TESTS=...]; make expected`
#    or: `make expected TESTS="test1 test2"`
.PHONY: expected
expected:
	@if [ -n "$(TESTS)" ]; then \
		TESTS_TO_UPDATE="$(TESTS)"; \
	elif [ ! -f regression.out ]; then \
		echo "All tests passed. Nothing to update."; \
		exit 0; \
	else \
		TESTS_TO_UPDATE=$$(awk -F ' - ' '/^(not )?ok/ {print $$2}' regression.out | awk '{print $$1}'); \
	fi; \
	if [ -z "$$TESTS_TO_UPDATE" ]; then \
		echo "No tests found in regression.out. Nothing to update."; \
		exit 0; \
	fi; \
	for test in $$TESTS_TO_UPDATE; do \
		if [ -f "results/$$test.out" ]; then \
			echo "Updating expected output for: $$test"; \
			cp "results/$$test.out" "expected/$$test.out"; \
		else \
			echo "Warning: result file for '$$test' not found. Skipping."; \
		fi; \
	done

# Create empty expected files for new tests if they don't exist.
setup_test_files:
	@mkdir -p expected
	@for test in $(REGRESS); do \
		if [ ! -f expected/$$test.out ]; then \
			mkdir -p `dirname "expected/$$test.out"`; \
			touch "expected/$$test.out"; \
		fi; \
	done

# 'fast' and 'benchmark' are dummy targets. Their presence in the command line
# (e.g., `make test fast`) is used to trigger the conditional logic that
# selects the desired test suite.
.PHONY: fast benchmark
fast:
	@:
benchmark:
	@:

# Target to show diff for failing tests. Use with 'vim' for vimdiff.
# `make diff-fail-all`: shows all failures.
# `make diff-fail-first`: shows the first failure.
.PHONY: diff-fail-all diff-fail-first vim vimo nvim nvimo
diff-fail-all diff-fail-first:
	@FAILED_TESTS=$$(grep 'not ok' regression.out 2>/dev/null | awk -F ' - ' '{print $$2}' | awk '{print $$1}'); \
	if [ "$@" = "diff-fail-first" ]; then \
		FAILED_TESTS=`echo "$$FAILED_TESTS" | head -n 1`; \
	fi; \
	if [ -n "$(filter vim vimo nvim nvimo,$(MAKECMDGOALS))" ]; then \
		EDITOR_CMD="vim"; \
		if [ -n "$(filter nvim nvimo,$(MAKECMDGOALS))" ]; then \
			EDITOR_CMD="nvim"; \
		fi; \
		EDITOR_OPTS="-d"; \
		if [ -n "$(filter vimo nvimo,$(MAKECMDGOALS))" ]; then \
			EDITOR_OPTS="-d -o"; \
		fi; \
		VIM_CMD="$$EDITOR_CMD $$EDITOR_OPTS"; \
		for test in $$FAILED_TESTS; do \
			if [ "$@" = "diff-fail-all" ]; then \
				echo "Next test: $$test"; \
				echo "Press C to continue, s to skip, or b to break (default: C)"; \
				read -n 1 -s input < /dev/tty; \
				if [ "$$input" = "b" ]; then \
					break; \
				elif [ "$$input" = "s" ]; then \
					continue; \
				fi; \
			fi; \
			echo "Running $$VIM_CMD for test: $$test"; \
			$$VIM_CMD "expected/$$test.out" "results/$$test.out" < /dev/tty; \
		done; \
	else \
		for test in $$FAILED_TESTS; do \
			echo "Showing diff for test: $$test"; \
			diff -u "expected/$$test.out" "results/$$test.out" || true; \
		done; \
	fi; \
	if [ -n "$$FAILED_TESTS" ]; then exit 1; fi

vim vimo nvim nvimo:
	@:

